# Agents-MCP-Host — environment template.
#
# Copy this file to `.env.local` and fill in your own values. `.env.local` and
# `.env` are both gitignored; never commit a filled-in copy.
#
# Every value below is intentionally EMPTY. An empty right-hand side is the only
# form that cannot be mistaken for a real credential — by an automated secret
# scanner or by a human skimming the file. The type, format and an example for
# each key live in the trailing comment, so this file still documents every
# variable the application reads.
#
# All keys are read at startup via getRequiredEnv() and the process fails fast
# if one is missing, EXCEPT DEFAULT_SCHEMA, which is an optional fallback.

# --- Runtime ---
ENVIRONMENT=                # required. Enum: WORK or PERSONAL

# --- Database (Oracle, ojdbc11 + UCP) ---
DB_HOST=                    # required. String — database host name or URL
DB_PORT=                    # required. Number — listener port, e.g. 1521
DB_SERVICE=                 # required. String — Oracle service name
DB_USER=                    # required. String — database user name
DB_PASSWORD=                # required. String — password for DB_USER
DEFAULT_SCHEMA=             # optional. String — schema used as a fallback when
                            #   a query does not name one explicitly

# --- LLM provider ---
LLM_API_KEY=                # required. String — API key for the LLM provider
LLM_API_URL=                # required. String — provider base URL,
                            #   e.g. https://api.example.com
LLM_CHAT_COMPLETIONS_PATH=  # required. String — chat-completions path,
                            #   e.g. /v1/chat/completions
LLM_MODEL_NAME=             # required. String — model identifier the provider
                            #   expects, e.g. gpt-4o-mini
LLM_REQUEST_TIMEOUT_MS=     # required. Number — request timeout in
                            #   milliseconds, e.g. 30000
